{
  "hosting": [
    {
      "target": "app",
      "public": "dist",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "rewrites": [
        {"source": "**", "destination": "/index.html"}
      ],
      "headers": [
        {"source":"**","headers":[{"key":"Content-Security-Policy","value":"default-src 'self' https:; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.gstatic.com https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://accounts.google.com https://apis.google.com https://js.stripe.com https://cdn.pluggy.ai https://static.cloudflareinsights.com blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src * data: blob:; media-src 'self' blob:; connect-src https: wss:; frame-src https://accounts.google.com https://virtus-fin-pro.firebaseapp.com https://virtus-financeiro-cd7bd.firebaseapp.com https://staging-13a0b.web.app https://sibanki.com.br https://www.sibanki.com.br https://js.stripe.com https://hooks.stripe.com https://connect.pluggy.ai; frame-ancestors 'self' https://sibanki.com.br https://www.sibanki.com.br"},{"key":"X-Frame-Options","value":"SAMEORIGIN"},{"key":"X-Content-Type-Options","value":"nosniff"},{"key":"Referrer-Policy","value":"strict-origin-when-cross-origin"},{"key":"Cache-Control","value":"no-cache, no-store, must-revalidate"}]},
        {"source":"**/*.js","headers":[{"key":"Cache-Control","value":"public, max-age=31536000, immutable"}]},
        {"source":"**/*.css","headers":[{"key":"Cache-Control","value":"public, max-age=31536000, immutable"}]},
        {"source":"**/*.svg","headers":[{"key":"Content-Type","value":"image/svg+xml"},{"key":"Cache-Control","value":"public, max-age=86400"}]},
        {"source":"**/*.mp4","headers":[{"key":"Cache-Control","value":"public, max-age=86400"},{"key":"Accept-Ranges","value":"bytes"},{"key":"Content-Type","value":"video/mp4"}]}
      ]
    },
    {
      "target": "landing",
      "public": "landing",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "cleanUrls": true,
      "headers": [
        {"source":"**","headers":[{"key":"X-Content-Type-Options","value":"nosniff"},{"key":"Referrer-Policy","value":"strict-origin-when-cross-origin"},{"key":"X-Frame-Options","value":"SAMEORIGIN"}]},
        {"source":"/","headers":[{"key":"Cache-Control","value":"public, max-age=300, must-revalidate"}]},
        {"source":"/index.html","headers":[{"key":"Cache-Control","value":"public, max-age=300, must-revalidate"}]},
        {"source":"/assets/**","headers":[{"key":"Cache-Control","value":"public, max-age=86400"}]}
      ]
    },
    {
      "target": "legado",
      "public": "public",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "rewrites": [
        {"source": "**", "destination": "/index.html"}
      ],
      "headers": [
        {"source":"**/*.html","headers":[{"key":"Cache-Control","value":"no-cache, no-store, must-revalidate"}]}
      ]
    },
    {
      "target": "staging",
      "public": "dist",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "rewrites": [
        {"source": "**", "destination": "/index.html"}
      ],
      "headers": [
        {"source":"**","headers":[{"key":"Content-Security-Policy","value":"default-src 'self' https:; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.gstatic.com https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://accounts.google.com https://apis.google.com https://js.stripe.com https://cdn.pluggy.ai blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src * data: blob:; connect-src https: wss:; frame-src https://accounts.google.com https://virtus-fin-pro.firebaseapp.com https://virtus-financeiro-cd7bd.firebaseapp.com https://staging-13a0b.web.app https://js.stripe.com https://hooks.stripe.com https://connect.pluggy.ai; frame-ancestors 'self'"},{"key":"X-Frame-Options","value":"SAMEORIGIN"},{"key":"X-Content-Type-Options","value":"nosniff"},{"key":"Referrer-Policy","value":"strict-origin-when-cross-origin"},{"key":"Cache-Control","value":"no-cache, no-store, must-revalidate"}]},
        {"source":"**/*.js","headers":[{"key":"Cache-Control","value":"public, max-age=31536000, immutable"}]},
        {"source":"**/*.css","headers":[{"key":"Cache-Control","value":"public, max-age=31536000, immutable"}]}
      ]
    },
    {
      "target": "admin",
      "public": "public/admin",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "rewrites": [{"source":"**","destination":"/index.html"}],
      "headers": [{"source":"**","headers":[{"key":"X-Frame-Options","value":"DENY"},{"key":"X-Content-Type-Options","value":"nosniff"},{"key":"Cache-Control","value":"no-cache, no-store, must-revalidate"}]}]
    },
    {
      "target": "docs",
      "public": "public/docs",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"]
    },
    {
      "target": "doc-investidor",
      "public": "public/doc-investidor",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"]
    }
  ],
  "functions": {
    "source": "functions",
    "runtime": "nodejs22"
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  }
}
