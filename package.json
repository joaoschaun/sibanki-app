{
  "name": "virtus-financeiro",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:legacy": "npx serve public -l 3000",
    "build": "vite build",
    "preview": "vite preview",
    "syntax-check": "node -e \"new Function(require('fs').readFileSync('public/app/app.js','utf8'))\"",
    "test": "playwright test",
    "test:smoke": "playwright test smoke",
    "test:fluxo": "playwright test fluxo-completo",
    "test:erros": "playwright test check-erros",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:compare": "playwright test compare-modulos-legado compare-modulos-react --config=playwright.config.cjs --project=compare-legado --project=compare-react",
    "test:compare:react": "playwright test compare-modulos-react --config=playwright.config.cjs --project=compare-react",
    "test:compare:legado": "playwright test compare-modulos-legado --config=playwright.config.cjs --project=compare-legado",
    "test:react-smoke": "playwright test --config=playwright.config.cjs --project=react-smoke",
    "test:curadoria": "playwright test curadoria --config=playwright.config.cjs --project=curadoria",
    "test:unit": "vitest run --config vitest.config.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "ci:local": "npm run typecheck && npm run test:unit && npm run build",
    "gate": "node scripts/pipeline-gate.mjs",
    "report": "playwright show-report",
    "deploy:staging": "npm run test:unit && npm run build && node scripts/clean-staging-dist.mjs && firebase deploy --only hosting:staging",
    "deploy:app": "npm run test:unit && npm run build && node scripts/prepare-dist.mjs && firebase deploy --only hosting:app",
    "deploy:legado": "npm run syntax-check && firebase deploy --only hosting:legado",
    "deploy:doc-investidor": "firebase deploy --only hosting:doc-investidor",
    "deploy:landing": "firebase deploy --only hosting:landing",
    "generate:splash": "node scripts/generate-splash.mjs",
    "cap:sync": "npx cap sync",
    "cap:open:android": "npx cap open android",
    "cap:open:ios": "npx cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/app": "^8.1.0",
    "@capacitor/core": "^8.4.1",
    "@capacitor/ios": "^8.4.1",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@capgo/capacitor-native-biometric": "^8.4.11",
    "clsx": "^2.1.1",
    "firebase": "^11.6.0",
    "framer-motion": "^12.42.0",
    "jspdf": "^4.2.0",
    "jspdf-autotable": "^5.0.7",
    "lightweight-charts": "^5.2.0",
    "lottie-react": "^2.4.1",
    "lucide-react": "^0.546.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-pluggy-connect": "^2.12.0",
    "react-router-dom": "^6.28.0",
    "recharts": "^3.8.0",
    "tailwind-merge": "^3.5.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.1",
    "@eslint/js": "^9.16.0",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.16.0",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.6.0",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.4"
  }
}
