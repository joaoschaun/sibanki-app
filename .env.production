# Variáveis públicas de build (Vite). priceIds NÃO são segredos.
# Provedor de billing ativo: 'asaas' (default) ou 'stripe'.
VITE_BILLING_PROVIDER=asaas
# ATENÇÃO: estes são os priceIds do modo TEST do Stripe (chave atual em
# functions/.env é sk_test). Ao migrar para LIVE, criar os preços no modo live
# e substituir aqui + STRIPE_PRICE_TO_PLAN nas functions.
VITE_STRIPE_PRICE_PRO_MONTHLY=price_1T5Fp1Hy6wEjpvXYYPVNuBXT
VITE_STRIPE_PRICE_PRO_YEARLY=price_1T5FqIHy6wEjpvXYjp0CNt9p
VITE_STRIPE_PRICE_FAMILIA_MONTHLY=price_1T5FreHy6wEjpvXYxDii3kQ9
VITE_STRIPE_PRICE_FAMILIA_YEARLY=price_1T5FsWHy6wEjpvXY6y3uvbDA
# App Check — Site key reCAPTCHA v3 (pública; a Secret key vai no Firebase
# Console → App Check, NUNCA aqui). Ativa App Check no client via src/firebase.ts.
VITE_APPCHECK_SITE_KEY=6Lc4IDItAAAAKSHuUPxBaydj5D5ysDxXzX3Pp7a
