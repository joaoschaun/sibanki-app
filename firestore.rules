rules_version = "2";
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthed() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isAuthed() && request.auth.token.role == "superadmin";
    }

    function sameTenant(tenantId) {
      return isAuthed() && request.auth.token.tenantId == tenantId;
    }

    function isTenantAdmin(tenantId) {
      return sameTenant(tenantId) && request.auth.token.role == "admin";
    }

    function isTenantUser(tenantId) {
      return sameTenant(tenantId) && (
        request.auth.token.role == "user" ||
        request.auth.token.role == "admin"
      );
    }

    function isOwner(userId) {
      return isAuthed() && request.auth.uid == userId;
    }

    // ── Schema validation ───────────────────────────────────────────────────

    /** Valida um lançamento individual (entriesOverflow — um doc = um lançamento). */
    function isValidEntry(data) {
      return data.keys().hasAll(['desc', 'value', 'date', 'type'])
        && data.desc is string
        && data.desc.size() > 0
        && data.desc.size() <= 200
        && data.value is number
        && data.value > 0
        && data.value <= 1000000000
        && data.date is string
        && data.date.size() == 10
        && data.type in ['receita', 'despesa', 'transferencia'];
    }

    /** Valida campos de topo do documento users/{uid}. */
    function isValidUserData(data) {
      // plan deve ser um dos valores permitidos se presente
      return (!('plan' in data) || data.plan in ['gratuito', 'pro', 'familia'])
        // openFinanceStatus deve ser um dos valores permitidos se presente
        && (!('openFinanceStatus' in data) || data.openFinanceStatus in ['ativo', 'inativo', 'pendente', null])
        // score deve ser número entre 0 e 100 se presente
        && (!('finScore' in data) || (data.finScore is number && data.finScore >= 0 && data.finScore <= 100))
        // sibcoinBalance deve ser número não-negativo se presente
        && (!('sibcoinBalance' in data) || (data.sibcoinBalance is number && data.sibcoinBalance >= 0));
    }

    function ownerInTenant(tenantId, userId) {
      return sameTenant(tenantId) && isOwner(userId);
    }

    function canReadTenantData(tenantId, userId) {
      return isSuperAdmin() || ownerInTenant(tenantId, userId) || isTenantAdmin(tenantId);
    }

    function canWriteTenantData(tenantId, userId) {
      return isSuperAdmin() || ownerInTenant(tenantId, userId) || isTenantAdmin(tenantId);
    }

    // Namespace principal multi-tenant
    match /tenants/{tenantId} {
      allow read: if isSuperAdmin() || sameTenant(tenantId);
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin() || isTenantAdmin(tenantId);
      allow delete: if isSuperAdmin();

      // Metadados do tenant (slug, domínio, plano, branding, features)
      match /meta/{docId} {
        allow read: if isSuperAdmin() || sameTenant(tenantId);
        allow create: if isSuperAdmin();
        allow update: if isSuperAdmin() || isTenantAdmin(tenantId);
        allow delete: if isSuperAdmin();
      }

      // Dados de usuário por tenant
      match /users/{userId} {
        allow read: if canReadTenantData(tenantId, userId);
        allow create: if isSuperAdmin() || ownerInTenant(tenantId, userId) || isTenantAdmin(tenantId);
        allow delete: if isSuperAdmin() || isTenantAdmin(tenantId);
        allow update: if canWriteTenantData(tenantId, userId) &&
          (
            // tenantId não pode ser alterado após criação
            !("tenantId" in resource.data) ||
            request.resource.data.tenantId == resource.data.tenantId
          );

        // Subcoleções financeiras do usuário
        match /{subCollection}/{docId} {
          allow read, create, update, delete: if canWriteTenantData(tenantId, userId);
        }

        // Consentimentos Open Finance: revoga (update), nunca deleta
        match /openFinanceConsents/{consentId} {
          allow read: if canReadTenantData(tenantId, userId);
          allow create: if canWriteTenantData(tenantId, userId);
          allow update: if canWriteTenantData(tenantId, userId);
          allow delete: if false;
        }

        // Logs de auditoria: append-only (sem update/delete)
        match /auditLogs/{logId} {
          allow read: if isSuperAdmin() || isTenantAdmin(tenantId) || ownerInTenant(tenantId, userId);
          allow create: if canWriteTenantData(tenantId, userId);
          allow update, delete: if false;
        }
      }

      // Catálogo/configuração do tenant
      match /config/{docId} {
        allow read: if isSuperAdmin() || sameTenant(tenantId);
        allow create, update: if isSuperAdmin() || isTenantAdmin(tenantId);
        allow delete: if isSuperAdmin();
      }

      match /categories/{categoryId} {
        allow read: if isSuperAdmin() || sameTenant(tenantId);
        allow create, update, delete: if isSuperAdmin() || isTenantAdmin(tenantId);
      }

      // Convites por tenant
      match /invites/{inviteId} {
        allow read: if isSuperAdmin() || isTenantAdmin(tenantId);
        allow create: if isSuperAdmin() || isTenantAdmin(tenantId);
        allow update: if isSuperAdmin() || isTenantAdmin(tenantId);
        allow delete: if isSuperAdmin();
      }

      // Auditoria de tenant: imutável
      match /audit/{auditId} {
        allow read: if isSuperAdmin() || isTenantAdmin(tenantId);
        allow create: if isSuperAdmin() || isTenantAdmin(tenantId);
        allow update, delete: if false;
      }
    }

    // Índice público para resolução por host/slug
    match /tenantPublic/{tenantKey} {
      allow read: if true;
      allow create, update, delete: if isSuperAdmin();
    }

    // SEG-01: Coleção de administradores autorizados. Acesso de leitura/escrita bloqueado no cliente (apenas backend)
    match /admins/{email} {
      allow read, write: if false;
    }

    // Lançamentos Pluggy arquivados (limite 1MB do documento users) — mesmo dono do uid
    match /users/{userId}/entriesOverflow/{docId} {
      allow read, delete: if isAuthed() && request.auth.uid == userId;
      allow create, update: if isAuthed()
        && request.auth.uid == userId
        && isValidEntry(request.resource.data);
    }

    // Logs de erro do cliente: append-only, dono só pode criar
    match /users/{userId}/errorLogs/{logId} {
      allow read: if isAuthed() && request.auth.uid == userId;
      allow create: if isAuthed() && request.auth.uid == userId;
      allow update, delete: if false;
    }

    // SEG-12: Quotas de uso da IA — escrito pelo backend (Cloud Function via
    // Admin SDK; o cliente nunca grava). Cliente pode LER a própria quota
    // para mostrar progresso em UI, mas não modificar.
    match /users/{userId}/quotas/{quotaId} {
      allow read: if isAuthed() && request.auth.uid == userId;
      allow create, update, delete: if false;
    }

    // PLG-2: Locks de sincronização Open Finance — escritos somente pelo
    // backend (Admin SDK); cliente pode LER para mostrar status na UI.
    match /users/{userId}/_syncLocks/{lockId} {
      allow read: if isAuthed() && request.auth.uid == userId;
      allow create, update, delete: if false;
    }

    // Legado (root): app React / hosting staging usam users/{uid} — só o dono lê/escreve.
    // Não confundir com tenants/{tenantId}/users/{userId} (regras acima).
    match /users/{userId} {
      allow read: if isAuthed() && request.auth.uid == userId;
      allow create: if isAuthed()
        && request.auth.uid == userId
        && isValidUserData(request.resource.data);
      allow update: if isAuthed()
        && request.auth.uid == userId
        && isValidUserData(request.resource.data);
      allow delete: if false;
    }

    // ── Modo Casal ────────────────────────────────────────────────────────────
    // Convites de vinculação familiar: quem está logado pode ler por toEmail,
    // criar (enviar convite) e cancelar o próprio convite.
    match /invites/{inviteId} {
      allow read: if isAuthed();
      allow create: if isAuthed() && request.resource.data.from == request.auth.uid;
      allow update: if isAuthed() && (
        // Quem criou pode cancelar (status -> rejected/cancelled)
        resource.data.from == request.auth.uid ||
        // Quem recebeu pode aceitar/rejeitar
        resource.data.toEmail == request.auth.token.email
      );
      allow delete: if isAuthed() && resource.data.from == request.auth.uid;
    }

    // Documento compartilhado do casal: qualquer membro pode ler e escrever.
    match /couples/{coupleId} {
      allow read: if isAuthed()
        && request.auth.uid in resource.data.members;
      allow create: if isAuthed()
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members.size() == 2;
      allow update: if isAuthed()
        && request.auth.uid in resource.data.members;
      allow delete: if isAuthed()
        && request.auth.uid in resource.data.members;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
