rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Dados do usuario - so o proprio pode ler/escrever
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    // Feedback do consultor IA (para treino futuro) - so o dono grava/lê
    match /users/{userId}/aiFeedback/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Casais - membros autenticados podem ler/escrever
    match /couples/{coupleId} {
      allow read, write: if request.auth != null;
    }

    // Convites - usuarios autenticados podem ler/escrever
    match /invites/{inviteId} {
      allow read, write: if request.auth != null;
    }

    // Comunidade - todos autenticados leem, criam e comentam. So o autor deleta.
    match /community/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Rate limits - so leitura pelo proprio usuario
    match /rateLimits/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // Codigos de vinculacao Telegram
    match /telegramCodes/{codeId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow delete: if request.auth != null;
    }

    // Interacoes nas noticias (curtir, comentar, reagir, visualizacoes)
    match /newsInteractions/{articleId} {
      allow read, write: if request.auth != null;
    }

    // Denuncias da comunidade
    match /community_reports/{reportId} {
      allow create: if request.auth != null;
      allow read, update, delete: if false;
    }

    // Ranking da comunidade (leitura publica para autenticados)
    match /community_ranking/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ── SOLUÇÕES FINANCEIRAS — cliques e cashback ──
    // Cliques por usuário — só o dono lê; app escreve
    match /users/{userId}/sol_cliques/{docId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update, delete: if false;
    }
    // Log global de cashbacks — só Cloud Function (admin SDK) escreve; admin lê
    match /cashback_log/{docId} {
      allow read, write: if false; // apenas admin SDK
    }
    // Cliques globais — só Cloud Function escreve
    match /sol_cliques_global/{docId} {
      allow read, write: if false;
    }

    // ── PROGRAMA FILIADO ──
    // Dados do programa filiado - só o próprio lê/escreve
    match /users/{userId}/filiado/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    // Lista de indicados do filiado - só o próprio lê; Cloud Function escreve via admin
    match /users/{userId}/indicados/{docId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false; // só Cloud Function (admin SDK) escreve
    }
    // Extrato SibCoin - só o próprio lê; Cloud Function escreve via admin
    match /users/{userId}/sibcoin/{docId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false; // só Cloud Function (admin SDK) escreve
    }
    // Feedback board (sugestões de features)
    match /feedbackBoard/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null && (
        resource.data.autorId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votos'])
      );
      allow delete: if request.auth != null && resource.data.autorId == request.auth.uid;
    }
    // Config global do Filiado - só leitura pelo app; escrita apenas pelo admin
    match /config/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Bloqueia tudo mais
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
