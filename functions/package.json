{
  "name": "sibanki-functions",
  "description": "Sibanki Cloud Functions - BRAPI Proxy",
  "version": "1.0.0",
  "engines": {
    "node": "22"
  },
  "main": "index.js",
  "scripts": {
    "test": "node --test tests/**/*.test.js",
    "test:coverage": "c8 --reporter=text --reporter=lcov node --test tests/**/*.test.js",
    "test:coverage:ci": "c8 --reporter=text --reporter=lcov --reporter=html --check-coverage --lines 85 --functions 85 --branches 60 node --test tests/**/*.test.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^4.22.1",
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^6.0.0",
    "node-fetch": "^2.7.0",
    "pluggy-sdk": "^0.83.0",
    "resend": "^6.9.3",
    "stripe": "^20.4.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "c8": "^11.0.0",
    "supertest": "^7.2.2"
  },
  "private": true
}
